<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Policy (аудит п.10).

  Глобально cleartext-трафик запрещён: все внешние AI-провайдеры и personal
  server должны использовать HTTPS.

  Единственное исключение — loopback (127.0.0.1 / localhost): локальный
  llama.cpp-сервер на самом устройстве не имеет сертификата, и HTTPS для
  него невозможен. Это безопасно, потому что трафик не покидает устройство.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
